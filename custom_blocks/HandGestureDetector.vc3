        {
          "id": "300",
          "type": "basic.code",
          "data": {
            "code": "import math\nimport cv2\nimport numpy as np\nimport mediapipe as mp\nfrom mediapipe.tasks import python as mp_python\nfrom mediapipe.tasks.python import vision\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    '''\n    ## Detects Hands and Recognises Simple Gestures (MediaPipe Hand Landmarker)\n    Runs MediaPipe's Hand Landmarker (Tasks API) on the input image to locate up\n    to two hands and their 21 landmarks each, and estimates a simple gesture from\n    the number of extended fingers.\n\n    The parameter `OutputType` selects what is shared on the `Out` pin:\n    `OutputType: image / landmarks`\\n\n    If `image` is given: the output is the input image with the hand landmarks,\n    connections and a gesture label drawn on it. Shared via `share_image()`.\\n\n    Else if `landmarks` is given: the output is a flat array of the first detected\n    hand's 21 normalised (x, y) landmarks followed by the extended-finger count,\n    so downstream blocks (e.g. MotorDriver / Teleoperator) can react to gestures.\n    Shared via `share_array()`.\n\n    The parameter `MirroredInput` should be set to `yes` if the image arriving on\n    `Img` is already horizontally mirrored (some camera pipelines flip the feed\n    for a \"selfie\" preview before it reaches this block). VisualCircuit's own\n    Camera block does NOT mirror, so the default `no` is correct in that case.\n    Mirroring reverses left/right chirality in the image, so the Left/Right label\n    is corrected automatically when `MirroredInput` is set to match reality.\n\n    **Inputs**: BGR Image (pin `Img`)\n\n    **Outputs**: BGR Image with landmarks drawn, or a landmark/gesture array (pin `Out`)\n\n    **Parameters**:\n    - OutputType ('image' for annotated image, 'landmarks' for the array)\n    - MirroredInput ('yes' if the incoming image is already mirrored, else 'no')\n\n    **Model**: utils/models/hand_landmarker/hand_landmarker.task (bundled, mirroring\n    the Haar cascade / YOLO models shipped with FaceDetector / ObjectDetector).\n    '''\n    choice = parameters.read_string(\"OutputType\")\n    try:\n        mirrored_input = parameters.read_string(\"MirroredInput\").strip().lower() == \"yes\"\n    except Exception:\n        mirrored_input = False\n\n    # Allow the block to run without an explicit Enable wire (mirrors FaceDetector).\n    auto_enable = False\n    try:\n        inputs.read_number(\"Enable\")\n    except Exception:\n        auto_enable = True\n\n    options = vision.HandLandmarkerOptions(\n        base_options=mp_python.BaseOptions(\n            model_asset_path=\"utils/models/hand_landmarker/hand_landmarker.task\"\n        ),\n        num_hands=2,\n        min_hand_detection_confidence=0.6,\n        min_tracking_confidence=0.5,\n    )\n    detector = vision.HandLandmarker.create_from_options(options)\n    connections = vision.HandLandmarksConnections.HAND_CONNECTIONS\n\n    # For the four fingers: TIP vs PIP, both measured from the WRIST. This is\n    # rotation-invariant (pure Euclidean distances) and needs no handedness.\n    FINGER_TIP_TO_REF = {8: 6, 12: 10, 16: 14, 20: 18}\n\n    def euclidean(a, b):\n        return math.hypot(a.x - b.x, a.y - b.y)\n\n    def is_thumb_extended(landmarks):\n        # The thumb doesn't curl toward the wrist like the other fingers -- it\n        # opens/closes laterally across the palm. Distance-from-wrist barely\n        # changes when it's tucked in, so that test misses a closed thumb.\n        # Instead compare TIP(4) and MCP(2) distance from PINKY_MCP(17), a\n        # landmark on the far side of the palm: an extended thumb is far from\n        # it, a tucked thumb collapses toward it. Still rotation-invariant.\n        pinky_mcp = landmarks[17]\n        return euclidean(landmarks[4], pinky_mcp) > euclidean(landmarks[2], pinky_mcp)\n\n    def count_extended_fingers(landmarks):\n        wrist = landmarks[0]\n        count = 1 if is_thumb_extended(landmarks) else 0\n        for tip_id, ref_id in FINGER_TIP_TO_REF.items():\n            if euclidean(landmarks[tip_id], wrist) > euclidean(landmarks[ref_id], wrist):\n                count += 1\n        return count\n\n    def resolve_handedness(raw_label):\n        # `mirrored_input` reflects whether the IMAGE FED to this block is\n        # already mirrored upstream (declared via the MirroredInput parameter)\n        # -- it is unrelated to any cosmetic display mirroring a downstream\n        # block might apply. Swapping here for any other reason reintroduces\n        # incorrect Left/Right labels.\n        if mirrored_input:\n            return \"Left\" if raw_label == \"Right\" else \"Right\"\n        return raw_label\n\n    while (auto_enable or inputs.read_number(\"Enable\")):\n        img = inputs.read_image(\"Img\")\n        if img is None:\n            continue\n\n        rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n        mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb)\n        result = detector.detect(mp_image)\n        h, w = img.shape[:2]\n\n        if choice == \"image\":\n            for i, landmarks in enumerate(result.hand_landmarks):\n                pts = [(int(lm.x * w), int(lm.y * h)) for lm in landmarks]\n                for conn in connections:\n                    cv2.line(img, pts[conn.start], pts[conn.end], (0, 255, 0), 2)\n                for p in pts:\n                    cv2.circle(img, p, 3, (0, 0, 255), -1)\n                label = \"Right\"\n                if i < len(result.handedness):\n                    label = resolve_handedness(result.handedness[i][0].category_name)\n                n = count_extended_fingers(landmarks)\n                cv2.putText(\n                    img,\n                    f\"{label}: {n} fingers\",\n                    (pts[0][0], max(20, pts[0][1] - 10)),\n                    cv2.FONT_HERSHEY_SIMPLEX,\n                    0.6,\n                    (0, 255, 0),\n                    2,\n                )\n            outputs.share_image(\"Out\", img)\n        else:\n            # A fixed-length payload keeps the array stable when no hand is present:\n            # 21 landmarks * (x, y) + 1 finger count = 43 values.\n            payload = [0.0] * (21 * 2 + 1)\n            if result.hand_landmarks:\n                landmarks = result.hand_landmarks[0]\n                coords = []\n                for lm in landmarks:\n                    coords.extend([float(lm.x), float(lm.y)])\n                coords.append(float(count_extended_fingers(landmarks)))\n                payload = coords\n            outputs.share_array(\"Out\", payload)\n\n    synchronise()\n",
            "params": [],
            "ports": {
              "in": [
                {
                  "name": "Inp-0"
                }
              ],
              "out": [
                {
                  "name": "Out-0"
                }
              ]
            }
          },
          "position": {
