{
  "version": "1.0",
  "package": {
    "name": "HandGestureDetector",
    "version": "1.2.0",
    "description": "Detects hands and simple gestures (rotation-invariant, thumb-aware extended-finger count) using MediaPipe Hand Landmarker.",
    "author": "prawnsgupta",
    "image": "%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20height%3D%22512%22%20viewBox%3D%220%200%2024%2024%22%20width%3D%22512%22%3E%3Cpath%20fill%3D%22%23607d8b%22%20d%3D%22M13%201a1%201%200%200%200-1%201v8h-1V3a1%201%200%201%200-2%200v7H8V4a1%201%200%201%200-2%200v8.2l-1.3-1.6a1.3%201.3%200%200%200-2%201.6l3%204.3A6%206%200%200%200%208.7%2020l.3.4V23h9v-2.8a8%208%200%200%200%201-3.9V6a1%201%200%201%200-2%200v4h-1V2a1%201%200%200%200-1-1z%22%2F%3E%3C%2Fsvg%3E"
  },
  "design": {
