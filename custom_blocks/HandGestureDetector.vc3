{"editor": {"id": "0d8bf099-aa08-41a8-89d0-a3fc791f25e6", "offsetX": 428, "offsetY": -36, "zoom": 100, "gridSize": 0, "layers": [{"id": "29c3dbf7-75dd-40be-bc17-7d9218ba22de", "type": "diagram-links", "isSvg": true, "transformed": true, "models": {"1c6692aa-f38c-49fa-b8e2-c5259fe6a340": {"id": "1c6692aa-f38c-49fa-b8e2-c5259fe6a340", "type": "default", "selected": false, "source": "5b197df0-b006-4277-9d90-17ec4a20a25b", "sourcePort": "25160490-e96c-41b9-9026-26f4f60de530", "target": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "targetPort": "a4e6885f-0769-4bd9-8c76-bbf480d0587e", "points": [{"id": "a96f94ef-7288-4bb1-bd97-6cfd5233699d", "type": "point", "x": -2.699981689453125, "y": 303.6000061035156}, {"id": "4dd8de9e-d1ea-4df1-94f7-7d138585a366", "type": "point", "x": 109.29998779296875, "y": 385.125}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "fbbe5762-0fae-4341-ba06-c7aaea37b5d6": {"id": "fbbe5762-0fae-4341-ba06-c7aaea37b5d6", "type": "default", "selected": false, "source": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "sourcePort": "a4e6885f-0769-4bd9-8c76-bbf480d0587e", "target": "5b197df0-b006-4277-9d90-17ec4a20a25b", "targetPort": "25160490-e96c-41b9-9026-26f4f60de530", "points": [{"id": "aedef5b4-0db2-4250-b54e-3371023ef417", "type": "point", "x": 109.29998779296875, "y": 385.125}, {"id": "841b2244-21c4-40fe-899a-d3eda60bce48", "type": "point", "x": -2.699981689453125, "y": 303.6000061035156}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "139cd99b-0ed9-4032-9ee7-d8e1e5a3348b": {"id": "139cd99b-0ed9-4032-9ee7-d8e1e5a3348b", "type": "default", "selected": false, "source": "b9cc7ac6-7369-468d-a642-506ca2bc0d39", "sourcePort": "b380b4a4-635e-4ffc-9817-b7c39f39555c", "target": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "targetPort": "0edbaecf-7dad-4441-be28-d19b015be631", "points": [{"id": "ca135f9b-fa5c-459c-9318-2988029945e0", "type": "point", "x": 3.300018310546875, "y": 488.6000061035156}, {"id": "fe5d1f47-0046-4d9b-aaee-5e93b036d0c4", "type": "point", "x": 109.29998779296875, "y": 501.0625}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "0503ec2f-81cb-438e-bcf5-12eefb7931cc": {"id": "0503ec2f-81cb-438e-bcf5-12eefb7931cc", "type": "default", "selected": false, "source": "0010-1ee1bf04-4609-4988-b441-4d0f8e1cff89", "sourcePort": "6bf45cf2-f994-427f-a30e-987d51966523", "target": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "targetPort": "ca9a5818-32a2-419a-9fdb-7892bbe6eb94", "points": [{"id": "d0e8fb07-9b5c-4d9c-a9bb-98840974caa5", "type": "point", "x": 363.79998779296875, "y": 157.90000915527344}, {"id": "5fbe20ec-06f9-4510-96a6-f121bf0a4d8b", "type": "point", "x": 352.7750244140625, "y": 269.20001220703125}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "7780bd69-0494-4407-a72c-08af14f462a2": {"id": "7780bd69-0494-4407-a72c-08af14f462a2", "type": "default", "selected": false, "source": "3fcd0481-3641-407c-a553-7440302a4400", "sourcePort": "0188bbe4-c679-403b-a21f-5b95f97260ae", "target": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "targetPort": "7f836726-bb2d-4c9a-a8f4-3cee958239e8", "points": [{"id": "46c21548-a62d-4d17-a85b-01ba4cd2d30a", "type": "point", "x": 571.2999877929688, "y": 469.6000061035156}, {"id": "c6a54291-5ca4-4b49-a2b8-4b672cb5f7ef", "type": "point", "x": 460.22503662109375, "y": 443.1000061035156}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "4bd0c8d6-fb3c-468c-ad5e-ffebe0a04055": {"id": "4bd0c8d6-fb3c-468c-ad5e-ffebe0a04055", "type": "default", "selected": false, "source": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "sourcePort": "7f836726-bb2d-4c9a-a8f4-3cee958239e8", "target": "3fcd0481-3641-407c-a553-7440302a4400", "targetPort": "0188bbe4-c679-403b-a21f-5b95f97260ae", "points": [{"id": "9a8ddfd3-4dc2-4e8c-8587-1b92989ab045", "type": "point", "x": 460.22503662109375, "y": 443.1000061035156}, {"id": "da5a89f4-544b-4bb7-884f-b3bcddab6a0d", "type": "point", "x": 571.2999877929688, "y": 469.6000061035156}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "482cc61a-6dce-4d2e-aef4-fb6bec0e2767": {"id": "482cc61a-6dce-4d2e-aef4-fb6bec0e2767", "type": "default", "selected": false, "source": "0c7cd5fd-af82-4c5a-881a-4ebe7c1cd19c", "sourcePort": "36fe8688-9aa8-4bc8-a21c-f3f9068a847f", "target": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "targetPort": "630532ae-7172-4b31-95b8-987b7483420d", "points": [{"id": "aa636cbc-88ad-4008-b66d-077b5b970465", "type": "point", "x": 563.7999877929688, "y": 582.1000061035156}, {"id": "fc53c50b-7984-485b-b8fe-5c1e72f4bee6", "type": "point", "x": 452.72503662109375, "y": 495.6000061035156}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "acd35ebb-17a3-4492-ad1c-517b06a82c40": {"id": "acd35ebb-17a3-4492-ad1c-517b06a82c40", "type": "default", "selected": false, "source": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "sourcePort": "630532ae-7172-4b31-95b8-987b7483420d", "target": "0c7cd5fd-af82-4c5a-881a-4ebe7c1cd19c", "targetPort": "36fe8688-9aa8-4bc8-a21c-f3f9068a847f", "points": [{"id": "d1c0f117-c4b3-4129-8b7b-bbd9c960c4fd", "type": "point", "x": 452.72503662109375, "y": 495.6000061035156}, {"id": "72abada9-0e3e-41a6-9b02-7c38acca6acd", "type": "point", "x": 563.7999877929688, "y": 582.1000061035156}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}}}, {"id": "dc0057dc-a1de-4d4e-8c44-9f55cc28fc70", "type": "diagram-nodes", "isSvg": false, "transformed": true, "models": {"13028433-6b0e-40cc-beec-f0fde2ac8cc7": {"id": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "type": "basic.code", "selected": false, "x": 101, "y": 192, "ports": [{"id": "a4e6885f-0769-4bd9-8c76-bbf480d0587e", "type": "port.input", "x": 101.79998779296875, "y": 377.625, "name": "Img", "alignment": "left", "parentNode": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "links": ["1c6692aa-f38c-49fa-b8e2-c5259fe6a340", "fbbe5762-0fae-4341-ba06-c7aaea37b5d6"], "in": true, "label": "Img", "hideLabel": false}, {"id": "0edbaecf-7dad-4441-be28-d19b015be631", "type": "port.input", "x": 101.79998779296875, "y": 493.5625, "name": "Enable", "alignment": "left", "parentNode": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "links": ["139cd99b-0ed9-4032-9ee7-d8e1e5a3348b"], "in": true, "label": "Enable", "hideLabel": false}, {"id": "7f836726-bb2d-4c9a-a8f4-3cee958239e8", "type": "port.output", "x": 452.72503662109375, "y": 435.6000061035156, "name": "Image", "alignment": "right", "parentNode": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "links": ["7780bd69-0494-4407-a72c-08af14f462a2", "4bd0c8d6-fb3c-468c-ad5e-ffebe0a04055"], "in": false, "label": "Image", "hideLabel": false}, {"id": "ca9a5818-32a2-419a-9fdb-7892bbe6eb94", "type": "port.parameter", "x": 345.2750244140625, "y": 261.70001220703125, "name": "MirroredInput", "alignment": "top", "parentNode": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "links": ["0503ec2f-81cb-438e-bcf5-12eefb7931cc"], "in": true, "label": "MirroredInput", "hideLabel": false}, {"id": "630532ae-7172-4b31-95b8-987b7483420d", "type": "port.output", "x": 452.72503662109375, "y": 495.6000061035156, "name": "Gesture", "alignment": "right", "parentNode": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "links": ["482cc61a-6dce-4d2e-aef4-fb6bec0e2767", "acd35ebb-17a3-4492-ad1c-517b06a82c40"], "in": false, "label": "Gesture", "hideLabel": false}], "data": {"code": "import math\nimport cv2\nimport numpy as np\nimport mediapipe as mp\nfrom mediapipe.tasks import python as mp_python\nfrom mediapipe.tasks.python import vision\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    '''\n    ## Detects Hands and Recognises Finger Gestures\n    This block runs MediaPipe's Hand Landmarker on the input image to find up to two hands\n    and the 21 landmarks of each one, and works out which fingers are held up. Both outputs\n    below come from the same detection pass, so wiring up both at once does not run the\n    detector twice.\n\n    **Inputs**: BGR Image\n\n    **Outputs**: wire up either one of these, or both. Whichever you leave unconnected is\n    simply skipped.\n    - `Image`: the input image with the hand landmarks, the connections between them and a\n      finger count drawn on it.\n    - `Gesture`: a 2x5 array where row 0 is the left hand and row 1 is the right one, and the\n      five columns are the thumb, index, middle, ring and pinky. A 1 means that finger is\n      held up. A hand that is not in frame stays all zeros.\n\n    **Parameters**: MirroredInput should be set to `yes` when the image reaching this block\n    has already been flipped somewhere upstream, since flipping swaps which hand is which.\n    The Camera block does not flip, so `no` is the right value in most circuits.\n    '''\n    mirrored = parameters.read_string(\"MirroredInput\").strip().lower() == \"yes\"\n\n    auto_enable = False\n    try:\n        inputs.read_number(\"Enable\")\n    except Exception:\n        auto_enable = True\n\n    def is_connected(name):\n        # An output pin only reaches the block if the circuit wires something to it, so\n        # writing to a pin that was left unconnected raises and takes the block down with\n        # it. Check once here instead of finding out one frame in.\n        declared = getattr(outputs, \"outputs\", None)\n        return declared is None or name in declared\n\n    send_image = is_connected(\"Image\")\n    send_gesture = is_connected(\"Gesture\")\n\n    options = vision.HandLandmarkerOptions(\n        base_options=mp_python.BaseOptions(\n            model_asset_path='utils/models/hand_landmarker/hand_landmarker.task'),\n        num_hands=2,\n        min_hand_detection_confidence=0.6,\n        min_tracking_confidence=0.5)\n    detector = vision.HandLandmarker.create_from_options(options)\n    connections = vision.HandLandmarksConnections.HAND_CONNECTIONS\n\n    # Each fingertip and the joint just below it, both measured out from the wrist,\n    # so the test still holds when the hand is rotated.\n    finger_joints = {8: 6, 12: 10, 16: 14, 20: 18}\n\n    def distance(a, b):\n        return math.hypot(a.x - b.x, a.y - b.y)\n\n    def fingers_up(lm):\n        # The thumb folds across the palm instead of curling into it, so its distance from\n        # the wrist barely moves and that test misses it. Measuring from the pinky knuckle\n        # works better: a tucked thumb collapses towards it, an open one sits far away.\n        states = [distance(lm[4], lm[17]) > distance(lm[2], lm[17])]\n        states += [distance(lm[tip], lm[0]) > distance(lm[joint], lm[0])\n                   for tip, joint in finger_joints.items()]\n        return states\n\n    def hand_label(raw):\n        if mirrored:\n            return 'Left' if raw == 'Right' else 'Right'\n        return raw\n\n    while (auto_enable or inputs.read_number(\"Enable\")):\n        img = inputs.read_image(\"Img\")\n        if img is None:\n            continue\n\n        rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n        result = detector.detect(mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb))\n\n        gesture = [[0.0] * 5, [0.0] * 5]\n        annotated = img.copy() if send_image else None\n        h, w = img.shape[:2]\n\n        for i, lm in enumerate(result.hand_landmarks):\n            label = hand_label(result.handedness[i][0].category_name)\n            states = fingers_up(lm)\n\n            row = 0 if label == 'Left' else 1\n            gesture[row] = [float(up) for up in states]\n\n            # Nothing is reading the picture, so skip the drawing rather than paint a\n            # frame that gets thrown away.\n            if not send_image:\n                continue\n\n            points = [(int(p.x * w), int(p.y * h)) for p in lm]\n            for c in connections:\n                cv2.line(annotated, points[c.start], points[c.end], (0, 255, 0), 2)\n            for p in points:\n                cv2.circle(annotated, p, 3, (0, 0, 255), -1)\n            cv2.putText(annotated, f'{label}: {sum(states)} fingers',\n                        (points[0][0], max(20, points[0][1] - 10)),\n                        cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0), 2)\n\n        if send_image:\n            outputs.share_image('Image', annotated)\n        if send_gesture:\n            outputs.share_array('Gesture', gesture)\n\n        synchronise()\n", "frequency": "30", "params": [{"name": "MirroredInput"}], "ports": {"in": [{"name": "Img"}, {"name": "Enable"}], "out": [{"name": "Image"}, {"name": "Gesture"}]}, "size": {"width": "300px", "height": "300px"}}}, "5b197df0-b006-4277-9d90-17ec4a20a25b": {"id": "5b197df0-b006-4277-9d90-17ec4a20a25b", "type": "basic.input", "selected": false, "x": -96, "y": 276, "ports": [{"id": "25160490-e96c-41b9-9026-26f4f60de530", "type": "port.output", "x": -10.199981689453125, "y": 296.1000061035156, "name": "input-out", "alignment": "right", "parentNode": "5b197df0-b006-4277-9d90-17ec4a20a25b", "links": ["1c6692aa-f38c-49fa-b8e2-c5259fe6a340", "fbbe5762-0fae-4341-ba06-c7aaea37b5d6"], "in": false, "label": "Img", "hideLabel": true}], "data": {"name": "Img"}}, "b9cc7ac6-7369-468d-a642-506ca2bc0d39": {"id": "b9cc7ac6-7369-468d-a642-506ca2bc0d39", "type": "basic.input", "selected": false, "x": -90, "y": 461, "ports": [{"id": "b380b4a4-635e-4ffc-9817-b7c39f39555c", "type": "port.output", "x": -4.199981689453125, "y": 481.1000061035156, "name": "input-out", "alignment": "right", "parentNode": "b9cc7ac6-7369-468d-a642-506ca2bc0d39", "links": ["139cd99b-0ed9-4032-9ee7-d8e1e5a3348b"], "in": false, "label": "Enable", "hideLabel": true}], "data": {"name": "Enable"}}, "0010-1ee1bf04-4609-4988-b441-4d0f8e1cff89": {"id": "0010-1ee1bf04-4609-4988-b441-4d0f8e1cff89", "type": "basic.constant", "selected": false, "x": 303, "y": 40, "ports": [{"id": "6bf45cf2-f994-427f-a30e-987d51966523", "type": "port.output", "x": 356.29998779296875, "y": 150.40000915527344, "name": "constant-out", "alignment": "bottom", "parentNode": "0010-1ee1bf04-4609-4988-b441-4d0f8e1cff89", "links": ["0503ec2f-81cb-438e-bcf5-12eefb7931cc"], "in": false, "label": "MirroredInput", "hideLabel": true}], "data": {"name": "MirroredInput", "value": "no", "local": true}}, "3fcd0481-3641-407c-a553-7440302a4400": {"id": "3fcd0481-3641-407c-a553-7440302a4400", "type": "basic.output", "selected": false, "x": 563, "y": 442, "ports": [{"id": "0188bbe4-c679-403b-a21f-5b95f97260ae", "type": "port.input", "x": 563.7999877929688, "y": 462.1000061035156, "name": "output-in", "alignment": "left", "parentNode": "3fcd0481-3641-407c-a553-7440302a4400", "links": ["7780bd69-0494-4407-a72c-08af14f462a2", "4bd0c8d6-fb3c-468c-ad5e-ffebe0a04055"], "in": true, "label": "output-in", "hideLabel": true}], "data": {"name": "Image"}}, "0c7cd5fd-af82-4c5a-881a-4ebe7c1cd19c": {"id": "0c7cd5fd-af82-4c5a-881a-4ebe7c1cd19c", "type": "basic.output", "selected": false, "x": 563, "y": 562, "ports": [{"id": "36fe8688-9aa8-4bc8-a21c-f3f9068a847f", "type": "port.input", "x": 563.7999877929688, "y": 582.1000061035156, "name": "output-in", "alignment": "left", "parentNode": "0c7cd5fd-af82-4c5a-881a-4ebe7c1cd19c", "links": ["482cc61a-6dce-4d2e-aef4-fb6bec0e2767", "acd35ebb-17a3-4492-ad1c-517b06a82c40"], "in": true, "label": "output-in", "hideLabel": true}], "data": {"name": "Gesture"}}}}]}, "version": "3.0", "package": {"name": "HandGestureDetector", "version": "1.5.0", "description": "Detects hands with MediaPipe and reports which fingers are held up, as separate Image and Gesture outputs from one detection pass", "author": "Priyansh Gupta", "image": "data:image/svg+xml;base64,", "category": "", "tags": []}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "type": "basic.code", "data": {"code": "import math\nimport cv2\nimport numpy as np\nimport mediapipe as mp\nfrom mediapipe.tasks import python as mp_python\nfrom mediapipe.tasks.python import vision\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    '''\n    ## Detects Hands and Recognises Finger Gestures\n    This block runs MediaPipe's Hand Landmarker on the input image to find up to two hands\n    and the 21 landmarks of each one, and works out which fingers are held up. Both outputs\n    below come from the same detection pass, so wiring up both at once does not run the\n    detector twice.\n\n    **Inputs**: BGR Image\n\n    **Outputs**: wire up either one of these, or both. Whichever you leave unconnected is\n    simply skipped.\n    - `Image`: the input image with the hand landmarks, the connections between them and a\n      finger count drawn on it.\n    - `Gesture`: a 2x5 array where row 0 is the left hand and row 1 is the right one, and the\n      five columns are the thumb, index, middle, ring and pinky. A 1 means that finger is\n      held up. A hand that is not in frame stays all zeros.\n\n    **Parameters**: MirroredInput should be set to `yes` when the image reaching this block\n    has already been flipped somewhere upstream, since flipping swaps which hand is which.\n    The Camera block does not flip, so `no` is the right value in most circuits.\n    '''\n    mirrored = parameters.read_string(\"MirroredInput\").strip().lower() == \"yes\"\n\n    auto_enable = False\n    try:\n        inputs.read_number(\"Enable\")\n    except Exception:\n        auto_enable = True\n\n    def is_connected(name):\n        # An output pin only reaches the block if the circuit wires something to it, so\n        # writing to a pin that was left unconnected raises and takes the block down with\n        # it. Check once here instead of finding out one frame in.\n        declared = getattr(outputs, \"outputs\", None)\n        return declared is None or name in declared\n\n    send_image = is_connected(\"Image\")\n    send_gesture = is_connected(\"Gesture\")\n\n    options = vision.HandLandmarkerOptions(\n        base_options=mp_python.BaseOptions(\n            model_asset_path='utils/models/hand_landmarker/hand_landmarker.task'),\n        num_hands=2,\n        min_hand_detection_confidence=0.6,\n        min_tracking_confidence=0.5)\n    detector = vision.HandLandmarker.create_from_options(options)\n    connections = vision.HandLandmarksConnections.HAND_CONNECTIONS\n\n    # Each fingertip and the joint just below it, both measured out from the wrist,\n    # so the test still holds when the hand is rotated.\n    finger_joints = {8: 6, 12: 10, 16: 14, 20: 18}\n\n    def distance(a, b):\n        return math.hypot(a.x - b.x, a.y - b.y)\n\n    def fingers_up(lm):\n        # The thumb folds across the palm instead of curling into it, so its distance from\n        # the wrist barely moves and that test misses it. Measuring from the pinky knuckle\n        # works better: a tucked thumb collapses towards it, an open one sits far away.\n        states = [distance(lm[4], lm[17]) > distance(lm[2], lm[17])]\n        states += [distance(lm[tip], lm[0]) > distance(lm[joint], lm[0])\n                   for tip, joint in finger_joints.items()]\n        return states\n\n    def hand_label(raw):\n        if mirrored:\n            return 'Left' if raw == 'Right' else 'Right'\n        return raw\n\n    while (auto_enable or inputs.read_number(\"Enable\")):\n        img = inputs.read_image(\"Img\")\n        if img is None:\n            continue\n\n        rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n        result = detector.detect(mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb))\n\n        gesture = [[0.0] * 5, [0.0] * 5]\n        annotated = img.copy() if send_image else None\n        h, w = img.shape[:2]\n\n        for i, lm in enumerate(result.hand_landmarks):\n            label = hand_label(result.handedness[i][0].category_name)\n            states = fingers_up(lm)\n\n            row = 0 if label == 'Left' else 1\n            gesture[row] = [float(up) for up in states]\n\n            # Nothing is reading the picture, so skip the drawing rather than paint a\n            # frame that gets thrown away.\n            if not send_image:\n                continue\n\n            points = [(int(p.x * w), int(p.y * h)) for p in lm]\n            for c in connections:\n                cv2.line(annotated, points[c.start], points[c.end], (0, 255, 0), 2)\n            for p in points:\n                cv2.circle(annotated, p, 3, (0, 0, 255), -1)\n            cv2.putText(annotated, f'{label}: {sum(states)} fingers',\n                        (points[0][0], max(20, points[0][1] - 10)),\n                        cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0), 2)\n\n        if send_image:\n            outputs.share_image('Image', annotated)\n        if send_gesture:\n            outputs.share_array('Gesture', gesture)\n\n        synchronise()\n", "frequency": "30", "params": [{"name": "MirroredInput"}], "ports": {"in": [{"name": "Img"}, {"name": "Enable"}], "out": [{"name": "Image"}, {"name": "Gesture"}]}, "size": {"width": "300px", "height": "300px"}}, "position": {"x": 101, "y": 192}}, {"id": "5b197df0-b006-4277-9d90-17ec4a20a25b", "type": "basic.input", "data": {"name": "Img"}, "position": {"x": -96, "y": 276}}, {"id": "b9cc7ac6-7369-468d-a642-506ca2bc0d39", "type": "basic.input", "data": {"name": "Enable"}, "position": {"x": -90, "y": 461}}, {"id": "0010-1ee1bf04-4609-4988-b441-4d0f8e1cff89", "type": "basic.constant", "data": {"name": "MirroredInput", "value": "no", "local": true}, "position": {"x": 303, "y": 40}}, {"id": "3fcd0481-3641-407c-a553-7440302a4400", "type": "basic.output", "data": {"name": "Image"}, "position": {"x": 563, "y": 442}}, {"id": "0c7cd5fd-af82-4c5a-881a-4ebe7c1cd19c", "type": "basic.output", "data": {"name": "Gesture"}, "position": {"x": 563, "y": 560}}], "wires": [{"source": {"block": "5b197df0-b006-4277-9d90-17ec4a20a25b", "port": "input-out", "name": "Img"}, "target": {"block": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "port": "Img", "name": "Img"}}, {"source": {"block": "b9cc7ac6-7369-468d-a642-506ca2bc0d39", "port": "input-out", "name": "Enable"}, "target": {"block": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "port": "Enable", "name": "Enable"}}, {"source": {"block": "0010-1ee1bf04-4609-4988-b441-4d0f8e1cff89", "port": "constant-out", "name": "MirroredInput"}, "target": {"block": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "port": "MirroredInput", "name": "MirroredInput"}}, {"source": {"block": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "port": "Image", "name": "Image"}, "target": {"block": "3fcd0481-3641-407c-a553-7440302a4400", "port": "output-in", "name": "output-in"}}, {"source": {"block": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "port": "Gesture", "name": "Gesture"}, "target": {"block": "0c7cd5fd-af82-4c5a-881a-4ebe7c1cd19c", "port": "output-in", "name": "output-in"}}]}}, "dependencies": {}}