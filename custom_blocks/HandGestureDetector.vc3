{"editor": {"id": "0d8bf099-aa08-41a8-89d0-a3fc791f25e6", "offsetX": 428, "offsetY": -36, "zoom": 100, "gridSize": 0, "layers": [{"id": "29c3dbf7-75dd-40be-bc17-7d9218ba22de", "type": "diagram-links", "isSvg": true, "transformed": true, "models": {"1c6692aa-f38c-49fa-b8e2-c5259fe6a340": {"id": "1c6692aa-f38c-49fa-b8e2-c5259fe6a340", "type": "default", "selected": false, "source": "5b197df0-b006-4277-9d90-17ec4a20a25b", "sourcePort": "25160490-e96c-41b9-9026-26f4f60de530", "target": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "targetPort": "a4e6885f-0769-4bd9-8c76-bbf480d0587e", "points": [{"id": "a96f94ef-7288-4bb1-bd97-6cfd5233699d", "type": "point", "x": -2.699981689453125, "y": 303.6000061035156}, {"id": "4dd8de9e-d1ea-4df1-94f7-7d138585a366", "type": "point", "x": 109.29998779296875, "y": 385.125}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "fbbe5762-0fae-4341-ba06-c7aaea37b5d6": {"id": "fbbe5762-0fae-4341-ba06-c7aaea37b5d6", "type": "default", "selected": false, "source": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "sourcePort": "a4e6885f-0769-4bd9-8c76-bbf480d0587e", "target": "5b197df0-b006-4277-9d90-17ec4a20a25b", "targetPort": "25160490-e96c-41b9-9026-26f4f60de530", "points": [{"id": "aedef5b4-0db2-4250-b54e-3371023ef417", "type": "point", "x": 109.29998779296875, "y": 385.125}, {"id": "841b2244-21c4-40fe-899a-d3eda60bce48", "type": "point", "x": -2.699981689453125, "y": 303.6000061035156}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "139cd99b-0ed9-4032-9ee7-d8e1e5a3348b": {"id": "139cd99b-0ed9-4032-9ee7-d8e1e5a3348b", "type": "default", "selected": false, "source": "b9cc7ac6-7369-468d-a642-506ca2bc0d39", "sourcePort": "b380b4a4-635e-4ffc-9817-b7c39f39555c", "target": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "targetPort": "0edbaecf-7dad-4441-be28-d19b015be631", "points": [{"id": "ca135f9b-fa5c-459c-9318-2988029945e0", "type": "point", "x": 3.300018310546875, "y": 488.6000061035156}, {"id": "fe5d1f47-0046-4d9b-aaee-5e93b036d0c4", "type": "point", "x": 109.29998779296875, "y": 501.0625}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "bc6ddd9d-9bfd-4e14-8aa3-5aa66868e73e": {"id": "bc6ddd9d-9bfd-4e14-8aa3-5aa66868e73e", "type": "default", "selected": false, "source": "0008-b319b03b-88aa-40c7-b02f-f52435e27975", "sourcePort": "959793ae-ce90-45a6-96a9-9df1175c2e00", "target": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "targetPort": "44ab3051-b38b-4001-bf0a-58f2c224f8b6", "points": [{"id": "7e02ab00-ef07-4cda-a17d-39f687ebd85b", "type": "point", "x": 211.79998779296875, "y": 161.90000915527344}, {"id": "af47e7b5-8779-44fd-a63e-8baae314f517", "type": "point", "x": 211.7750244140625, "y": 269.20001220703125}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "0503ec2f-81cb-438e-bcf5-12eefb7931cc": {"id": "0503ec2f-81cb-438e-bcf5-12eefb7931cc", "type": "default", "selected": false, "source": "0010-1ee1bf04-4609-4988-b441-4d0f8e1cff89", "sourcePort": "6bf45cf2-f994-427f-a30e-987d51966523", "target": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "targetPort": "ca9a5818-32a2-419a-9fdb-7892bbe6eb94", "points": [{"id": "d0e8fb07-9b5c-4d9c-a9bb-98840974caa5", "type": "point", "x": 363.79998779296875, "y": 157.90000915527344}, {"id": "5fbe20ec-06f9-4510-96a6-f121bf0a4d8b", "type": "point", "x": 352.7750244140625, "y": 269.20001220703125}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "7780bd69-0494-4407-a72c-08af14f462a2": {"id": "7780bd69-0494-4407-a72c-08af14f462a2", "type": "default", "selected": false, "source": "3fcd0481-3641-407c-a553-7440302a4400", "sourcePort": "0188bbe4-c679-403b-a21f-5b95f97260ae", "target": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "targetPort": "7f836726-bb2d-4c9a-a8f4-3cee958239e8", "points": [{"id": "46c21548-a62d-4d17-a85b-01ba4cd2d30a", "type": "point", "x": 571.2999877929688, "y": 469.6000061035156}, {"id": "c6a54291-5ca4-4b49-a2b8-4b672cb5f7ef", "type": "point", "x": 460.22503662109375, "y": 443.1000061035156}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}, "4bd0c8d6-fb3c-468c-ad5e-ffebe0a04055": {"id": "4bd0c8d6-fb3c-468c-ad5e-ffebe0a04055", "type": "default", "selected": false, "source": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "sourcePort": "7f836726-bb2d-4c9a-a8f4-3cee958239e8", "target": "3fcd0481-3641-407c-a553-7440302a4400", "targetPort": "0188bbe4-c679-403b-a21f-5b95f97260ae", "points": [{"id": "9a8ddfd3-4dc2-4e8c-8587-1b92989ab045", "type": "point", "x": 460.22503662109375, "y": 443.1000061035156}, {"id": "da5a89f4-544b-4bb7-884f-b3bcddab6a0d", "type": "point", "x": 571.2999877929688, "y": 469.6000061035156}], "labels": [], "width": 3, "color": "gray", "curvyness": 50, "selectedColor": "rgb(0,192,255)"}}}, {"id": "dc0057dc-a1de-4d4e-8c44-9f55cc28fc70", "type": "diagram-nodes", "isSvg": false, "transformed": true, "models": {"13028433-6b0e-40cc-beec-f0fde2ac8cc7": {"id": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "type": "basic.code", "selected": false, "x": 101, "y": 192, "ports": [{"id": "a4e6885f-0769-4bd9-8c76-bbf480d0587e", "type": "port.input", "x": 101.79998779296875, "y": 377.625, "name": "Img", "alignment": "left", "parentNode": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "links": ["1c6692aa-f38c-49fa-b8e2-c5259fe6a340", "fbbe5762-0fae-4341-ba06-c7aaea37b5d6"], "in": true, "label": "Img", "hideLabel": false}, {"id": "0edbaecf-7dad-4441-be28-d19b015be631", "type": "port.input", "x": 101.79998779296875, "y": 493.5625, "name": "Enable", "alignment": "left", "parentNode": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "links": ["139cd99b-0ed9-4032-9ee7-d8e1e5a3348b"], "in": true, "label": "Enable", "hideLabel": false}, {"id": "7f836726-bb2d-4c9a-a8f4-3cee958239e8", "type": "port.output", "x": 452.72503662109375, "y": 435.6000061035156, "name": "Out", "alignment": "right", "parentNode": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "links": ["7780bd69-0494-4407-a72c-08af14f462a2", "4bd0c8d6-fb3c-468c-ad5e-ffebe0a04055"], "in": false, "label": "Out", "hideLabel": false}, {"id": "44ab3051-b38b-4001-bf0a-58f2c224f8b6", "type": "port.parameter", "x": 204.2750244140625, "y": 261.70001220703125, "name": "OutputType", "alignment": "top", "parentNode": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "links": ["bc6ddd9d-9bfd-4e14-8aa3-5aa66868e73e"], "in": true, "label": "OutputType", "hideLabel": false}, {"id": "ca9a5818-32a2-419a-9fdb-7892bbe6eb94", "type": "port.parameter", "x": 345.2750244140625, "y": 261.70001220703125, "name": "MirroredInput", "alignment": "top", "parentNode": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "links": ["0503ec2f-81cb-438e-bcf5-12eefb7931cc"], "in": true, "label": "MirroredInput", "hideLabel": false}], "data": {"code": "import math\nimport cv2\nimport numpy as np\nimport mediapipe as mp\nfrom mediapipe.tasks import python as mp_python\nfrom mediapipe.tasks.python import vision\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    '''\n    ## Detects Hands and Recognises Simple Gestures (MediaPipe Hand Landmarker)\n    Runs MediaPipe's Hand Landmarker (Tasks API) on the input image to locate up\n    to two hands and their 21 landmarks each, and estimates a simple gesture from\n    the number of extended fingers.\n\n    The parameter `OutputType` selects what is shared on the `Out` pin:\n    `OutputType: image / landmarks`\\n\n    If `image` is given: the output is the input image with the hand landmarks,\n    connections and a gesture label drawn on it. Shared via `share_image()`.\\n\n    Else if `landmarks` is given: the output is a flat array of the first detected\n    hand's 21 normalised (x, y) landmarks followed by the extended-finger count,\n    so downstream blocks (e.g. MotorDriver / Teleoperator) can react to gestures.\n    Shared via `share_array()`.\n\n    The parameter `MirroredInput` should be set to `yes` if the image arriving on\n    `Img` is already horizontally mirrored (some camera pipelines flip the feed\n    for a \"selfie\" preview before it reaches this block). VisualCircuit's own\n    Camera block does NOT mirror, so the default `no` is correct in that case.\n    Mirroring reverses left/right chirality in the image, so the Left/Right label\n    is corrected automatically when `MirroredInput` is set to match reality.\n\n    **Inputs**: BGR Image (pin `Img`)\n\n    **Outputs**: BGR Image with landmarks drawn, or a landmark/gesture array (pin `Out`)\n\n    **Parameters**:\n    - OutputType ('image' for annotated image, 'landmarks' for the array)\n    - MirroredInput ('yes' if the incoming image is already mirrored, else 'no')\n\n    **Model**: utils/models/hand_landmarker/hand_landmarker.task (bundled, mirroring\n    the Haar cascade / YOLO models shipped with FaceDetector / ObjectDetector).\n    '''\n    choice = parameters.read_string(\"OutputType\")\n    try:\n        mirrored_input = parameters.read_string(\"MirroredInput\").strip().lower() == \"yes\"\n    except Exception:\n        mirrored_input = False\n\n    # Allow the block to run without an explicit Enable wire (mirrors FaceDetector).\n    auto_enable = False\n    try:\n        inputs.read_number(\"Enable\")\n    except Exception:\n        auto_enable = True\n\n    options = vision.HandLandmarkerOptions(\n        base_options=mp_python.BaseOptions(\n            model_asset_path=\"utils/models/hand_landmarker/hand_landmarker.task\"\n        ),\n        num_hands=2,\n        min_hand_detection_confidence=0.6,\n        min_tracking_confidence=0.5,\n    )\n    detector = vision.HandLandmarker.create_from_options(options)\n    connections = vision.HandLandmarksConnections.HAND_CONNECTIONS\n\n    # For the four fingers: TIP vs PIP, both measured from the WRIST. This is\n    # rotation-invariant (pure Euclidean distances) and needs no handedness.\n    FINGER_TIP_TO_REF = {8: 6, 12: 10, 16: 14, 20: 18}\n\n    def euclidean(a, b):\n        return math.hypot(a.x - b.x, a.y - b.y)\n\n    def is_thumb_extended(landmarks):\n        # The thumb doesn't curl toward the wrist like the other fingers -- it\n        # opens/closes laterally across the palm. Distance-from-wrist barely\n        # changes when it's tucked in, so that test misses a closed thumb.\n        # Instead compare TIP(4) and MCP(2) distance from PINKY_MCP(17), a\n        # landmark on the far side of the palm: an extended thumb is far from\n        # it, a tucked thumb collapses toward it. Still rotation-invariant.\n        pinky_mcp = landmarks[17]\n        return euclidean(landmarks[4], pinky_mcp) > euclidean(landmarks[2], pinky_mcp)\n\n    def count_extended_fingers(landmarks):\n        wrist = landmarks[0]\n        count = 1 if is_thumb_extended(landmarks) else 0\n        for tip_id, ref_id in FINGER_TIP_TO_REF.items():\n            if euclidean(landmarks[tip_id], wrist) > euclidean(landmarks[ref_id], wrist):\n                count += 1\n        return count\n\n    def resolve_handedness(raw_label):\n        # `mirrored_input` reflects whether the IMAGE FED to this block is\n        # already mirrored upstream (declared via the MirroredInput parameter)\n        # -- it is unrelated to any cosmetic display mirroring a downstream\n        # block might apply. Swapping here for any other reason reintroduces\n        # incorrect Left/Right labels.\n        if mirrored_input:\n            return \"Left\" if raw_label == \"Right\" else \"Right\"\n        return raw_label\n\n    while (auto_enable or inputs.read_number(\"Enable\")):\n        img = inputs.read_image(\"Img\")\n        if img is None:\n            continue\n\n        rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n        mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb)\n        result = detector.detect(mp_image)\n        h, w = img.shape[:2]\n\n        if choice == \"image\":\n            for i, landmarks in enumerate(result.hand_landmarks):\n                pts = [(int(lm.x * w), int(lm.y * h)) for lm in landmarks]\n                for conn in connections:\n                    cv2.line(img, pts[conn.start], pts[conn.end], (0, 255, 0), 2)\n                for p in pts:\n                    cv2.circle(img, p, 3, (0, 0, 255), -1)\n                label = \"Right\"\n                if i < len(result.handedness):\n                    label = resolve_handedness(result.handedness[i][0].category_name)\n                n = count_extended_fingers(landmarks)\n                cv2.putText(\n                    img,\n                    f\"{label}: {n} fingers\",\n                    (pts[0][0], max(20, pts[0][1] - 10)),\n                    cv2.FONT_HERSHEY_SIMPLEX,\n                    0.6,\n                    (0, 255, 0),\n                    2,\n                )\n            outputs.share_image(\"Out\", img)\n        else:\n            # A fixed-length payload keeps the array stable when no hand is present:\n            # 21 landmarks * (x, y) + 1 finger count = 43 values.\n            payload = [0.0] * (21 * 2 + 1)\n            if result.hand_landmarks:\n                landmarks = result.hand_landmarks[0]\n                coords = []\n                for lm in landmarks:\n                    coords.extend([float(lm.x), float(lm.y)])\n                coords.append(float(count_extended_fingers(landmarks)))\n                payload = coords\n            outputs.share_array(\"Out\", payload)\n\n    synchronise()\n", "frequency": "30", "params": [{"name": "OutputType"}, {"name": "MirroredInput"}], "ports": {"in": [{"name": "Img"}, {"name": "Enable"}], "out": [{"name": "Out"}]}, "size": {"width": "300px", "height": "300px"}}}, "5b197df0-b006-4277-9d90-17ec4a20a25b": {"id": "5b197df0-b006-4277-9d90-17ec4a20a25b", "type": "basic.input", "selected": false, "x": -96, "y": 276, "ports": [{"id": "25160490-e96c-41b9-9026-26f4f60de530", "type": "port.output", "x": -10.199981689453125, "y": 296.1000061035156, "name": "input-out", "alignment": "right", "parentNode": "5b197df0-b006-4277-9d90-17ec4a20a25b", "links": ["1c6692aa-f38c-49fa-b8e2-c5259fe6a340", "fbbe5762-0fae-4341-ba06-c7aaea37b5d6"], "in": false, "label": "Img", "hideLabel": true}], "data": {"name": "Img"}}, "b9cc7ac6-7369-468d-a642-506ca2bc0d39": {"id": "b9cc7ac6-7369-468d-a642-506ca2bc0d39", "type": "basic.input", "selected": false, "x": -90, "y": 461, "ports": [{"id": "b380b4a4-635e-4ffc-9817-b7c39f39555c", "type": "port.output", "x": -4.199981689453125, "y": 481.1000061035156, "name": "input-out", "alignment": "right", "parentNode": "b9cc7ac6-7369-468d-a642-506ca2bc0d39", "links": ["139cd99b-0ed9-4032-9ee7-d8e1e5a3348b"], "in": false, "label": "Enable", "hideLabel": true}], "data": {"name": "Enable"}}, "0008-b319b03b-88aa-40c7-b02f-f52435e27975": {"id": "0008-b319b03b-88aa-40c7-b02f-f52435e27975", "type": "basic.constant", "selected": false, "x": 151, "y": 44, "ports": [{"id": "959793ae-ce90-45a6-96a9-9df1175c2e00", "type": "port.output", "x": 204.29998779296875, "y": 154.40000915527344, "name": "constant-out", "alignment": "bottom", "parentNode": "0008-b319b03b-88aa-40c7-b02f-f52435e27975", "links": ["bc6ddd9d-9bfd-4e14-8aa3-5aa66868e73e"], "in": false, "label": "OutputType", "hideLabel": true}], "data": {"name": "OutputType", "value": "image", "local": true}}, "0010-1ee1bf04-4609-4988-b441-4d0f8e1cff89": {"id": "0010-1ee1bf04-4609-4988-b441-4d0f8e1cff89", "type": "basic.constant", "selected": false, "x": 303, "y": 40, "ports": [{"id": "6bf45cf2-f994-427f-a30e-987d51966523", "type": "port.output", "x": 356.29998779296875, "y": 150.40000915527344, "name": "constant-out", "alignment": "bottom", "parentNode": "0010-1ee1bf04-4609-4988-b441-4d0f8e1cff89", "links": ["0503ec2f-81cb-438e-bcf5-12eefb7931cc"], "in": false, "label": "MirroredInput", "hideLabel": true}], "data": {"name": "MirroredInput", "value": "no", "local": true}}, "3fcd0481-3641-407c-a553-7440302a4400": {"id": "3fcd0481-3641-407c-a553-7440302a4400", "type": "basic.output", "selected": false, "x": 563, "y": 442, "ports": [{"id": "0188bbe4-c679-403b-a21f-5b95f97260ae", "type": "port.input", "x": 563.7999877929688, "y": 462.1000061035156, "name": "output-in", "alignment": "left", "parentNode": "3fcd0481-3641-407c-a553-7440302a4400", "links": ["7780bd69-0494-4407-a72c-08af14f462a2", "4bd0c8d6-fb3c-468c-ad5e-ffebe0a04055"], "in": true, "label": "output-in", "hideLabel": true}], "data": {"name": "Out"}}}}]}, "version": "3.0", "package": {"name": "HandGestureDetector", "version": "1.3.0", "description": "Detects hands with MediaPipe and reports which fingers are held up", "author": "Priyansh Gupta", "image": "data:image/svg+xml;base64,", "category": "", "tags": []}, "design": {"board": "Python3-Noetic", "graph": {"blocks": [{"id": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "type": "basic.code", "data": {"code": "import math\nimport cv2\nimport numpy as np\nimport mediapipe as mp\nfrom mediapipe.tasks import python as mp_python\nfrom mediapipe.tasks.python import vision\n\n\ndef main(inputs, outputs, parameters, synchronise):\n    '''\n    ## Detects Hands and Recognises Finger Gestures\n    This block runs MediaPipe's Hand Landmarker on the input image to find up to two hands\n    and the 21 landmarks of each one, and works out which fingers are held up.\n    It takes as an input the parameter `OutputType`. This parameter has three possible values:\n    `OutputType: image / landmarks / gesture`\\n\n    If `image` is given: the output is the image passed in with the landmarks, the connections\n    between them and a finger count drawn on it. Image is shared through the `share_image()`\n    function.\\n\n    If `landmarks` is given: the output is the first hand's 21 (x, y) points followed by the\n    number of fingers held up, as a flat array. It is shared through the `share_array()`\n    function.\\n\n    If `gesture` is given: the output is a 2x5 array where row 0 is the left hand and row 1 is\n    the right one, and the five columns are the thumb, index, middle, ring and pinky. A 1 means\n    that finger is held up. A hand that is not in frame stays all zeros. It is shared through\n    the `share_array()` function.\n\n    The parameter `MirroredInput` should be set to `yes` when the image reaching this block has\n    already been flipped somewhere upstream, since flipping swaps which hand is which. The\n    Camera block does not flip, so `no` is the right value in most circuits.\n\n    **Inputs**: BGR Image\n\n    **Outputs**: BGR Image with the landmarks drawn, or an array of landmarks / finger states\n\n    **Parameters**: OutputType ('image', 'landmarks' or 'gesture'), MirroredInput ('yes' / 'no')\n    '''\n    choice = parameters.read_string(\"OutputType\")\n    mirrored = parameters.read_string(\"MirroredInput\").strip().lower() == \"yes\"\n\n    auto_enable = False\n    try:\n        inputs.read_number(\"Enable\")\n    except Exception:\n        auto_enable = True\n\n    options = vision.HandLandmarkerOptions(\n        base_options=mp_python.BaseOptions(\n            model_asset_path='utils/models/hand_landmarker/hand_landmarker.task'),\n        num_hands=2,\n        min_hand_detection_confidence=0.6,\n        min_tracking_confidence=0.5)\n    detector = vision.HandLandmarker.create_from_options(options)\n    connections = vision.HandLandmarksConnections.HAND_CONNECTIONS\n\n    # Each fingertip and the joint just below it, both measured out from the wrist,\n    # so the test still holds when the hand is rotated.\n    finger_joints = {8: 6, 12: 10, 16: 14, 20: 18}\n\n    def distance(a, b):\n        return math.hypot(a.x - b.x, a.y - b.y)\n\n    def fingers_up(lm):\n        # The thumb folds across the palm instead of curling into it, so its distance from\n        # the wrist barely moves and that test misses it. Measuring from the pinky knuckle\n        # works better: a tucked thumb collapses towards it, an open one sits far away.\n        states = [distance(lm[4], lm[17]) > distance(lm[2], lm[17])]\n        states += [distance(lm[tip], lm[0]) > distance(lm[joint], lm[0])\n                   for tip, joint in finger_joints.items()]\n        return states\n\n    def hand_label(raw):\n        if mirrored:\n            return 'Left' if raw == 'Right' else 'Right'\n        return raw\n\n    while (auto_enable or inputs.read_number(\"Enable\")):\n        img = inputs.read_image(\"Img\")\n        if img is None:\n            continue\n\n        rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n        result = detector.detect(mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb))\n\n        if choice == 'image':\n            h, w = img.shape[:2]\n            for i, lm in enumerate(result.hand_landmarks):\n                points = [(int(p.x * w), int(p.y * h)) for p in lm]\n                for c in connections:\n                    cv2.line(img, points[c.start], points[c.end], (0, 255, 0), 2)\n                for p in points:\n                    cv2.circle(img, p, 3, (0, 0, 255), -1)\n                label = hand_label(result.handedness[i][0].category_name)\n                cv2.putText(img, f'{label}: {sum(fingers_up(lm))} fingers',\n                            (points[0][0], max(20, points[0][1] - 10)),\n                            cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0), 2)\n            outputs.share_image('Out', img)\n\n        elif choice == 'gesture':\n            gesture = [[0.0] * 5, [0.0] * 5]\n            for i, lm in enumerate(result.hand_landmarks):\n                row = 0 if hand_label(result.handedness[i][0].category_name) == 'Left' else 1\n                gesture[row] = [float(up) for up in fingers_up(lm)]\n            outputs.share_array('Out', gesture)\n\n        else:\n            # Fixed length so the wire keeps the same size on frames with no hand in them.\n            flat = [0.0] * 43\n            if result.hand_landmarks:\n                lm = result.hand_landmarks[0]\n                flat = [v for p in lm for v in (p.x, p.y)] + [float(sum(fingers_up(lm)))]\n            outputs.share_array('Out', flat)\n\n    synchronise()\n", "frequency": "30", "params": [{"name": "OutputType"}, {"name": "MirroredInput"}], "ports": {"in": [{"name": "Img"}, {"name": "Enable"}], "out": [{"name": "Out"}]}, "size": {"width": "300px", "height": "300px"}}, "position": {"x": 101, "y": 192}}, {"id": "5b197df0-b006-4277-9d90-17ec4a20a25b", "type": "basic.input", "data": {"name": "Img"}, "position": {"x": -96, "y": 276}}, {"id": "b9cc7ac6-7369-468d-a642-506ca2bc0d39", "type": "basic.input", "data": {"name": "Enable"}, "position": {"x": -90, "y": 461}}, {"id": "0008-b319b03b-88aa-40c7-b02f-f52435e27975", "type": "basic.constant", "data": {"name": "OutputType", "value": "image", "local": true}, "position": {"x": 151, "y": 44}}, {"id": "0010-1ee1bf04-4609-4988-b441-4d0f8e1cff89", "type": "basic.constant", "data": {"name": "MirroredInput", "value": "no", "local": true}, "position": {"x": 303, "y": 40}}, {"id": "3fcd0481-3641-407c-a553-7440302a4400", "type": "basic.output", "data": {"name": "Out"}, "position": {"x": 563, "y": 442}}], "wires": [{"source": {"block": "5b197df0-b006-4277-9d90-17ec4a20a25b", "port": "input-out", "name": "Img"}, "target": {"block": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "port": "Img", "name": "Img"}}, {"source": {"block": "b9cc7ac6-7369-468d-a642-506ca2bc0d39", "port": "input-out", "name": "Enable"}, "target": {"block": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "port": "Enable", "name": "Enable"}}, {"source": {"block": "0008-b319b03b-88aa-40c7-b02f-f52435e27975", "port": "constant-out", "name": "OutputType"}, "target": {"block": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "port": "OutputType", "name": "OutputType"}}, {"source": {"block": "0010-1ee1bf04-4609-4988-b441-4d0f8e1cff89", "port": "constant-out", "name": "MirroredInput"}, "target": {"block": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "port": "MirroredInput", "name": "MirroredInput"}}, {"source": {"block": "13028433-6b0e-40cc-beec-f0fde2ac8cc7", "port": "Out", "name": "Out"}, "target": {"block": "3fcd0481-3641-407c-a553-7440302a4400", "port": "output-in", "name": "output-in"}}]}}, "dependencies": {}}